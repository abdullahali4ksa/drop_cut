<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DropCut.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DropCut.Modules.Shell.Models"
    xmlns:viewModels="using:DropCut.Modules.Shell.ViewModels"
    mc:Ignorable="d"
    Title="DropCut">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource AppBackgroundBrush}"
          FlowDirection="{x:Bind GetFlowDirection(ViewModel.IsRtl), Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Window TitleBar -->
        <TitleBar x:Name="AppTitleBar" Title="DropCut" />

        <!-- 2. Fluent Command Toolbar with Bilingual ToolTips & Shortcuts -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="Transparent" IsDynamicOverflowEnabled="True">
            <AppBarButton Icon="Add" Label="New Snip" Command="{x:Bind ViewModel.AddNewTabCommand}">
                <ToolTipService.ToolTip>
                    <ToolTip Content="New Snip / لقطة جديدة (Ctrl+N)" />
                </ToolTipService.ToolTip>
            </AppBarButton>

            <AppBarSeparator />

            <AppBarButton Icon="Undo" Label="Undo">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Undo / تراجع (Ctrl+Z)" />
                </ToolTipService.ToolTip>
            </AppBarButton>

            <AppBarButton Icon="Redo" Label="Redo">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Redo / إعادة (Ctrl+Y)" />
                </ToolTipService.ToolTip>
            </AppBarButton>

            <AppBarSeparator />

            <AppBarButton Icon="Save" Label="Save">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Save / حفظ (Ctrl+S)" />
                </ToolTipService.ToolTip>
            </AppBarButton>

            <AppBarButton Icon="Copy" Label="Copy">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Copy / نسخ (Ctrl+C)" />
                </ToolTipService.ToolTip>
            </AppBarButton>

            <AppBarButton Icon="Share" Label="Share">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Drag &amp; Share / سحب ومشاركة" />
                </ToolTipService.ToolTip>
            </AppBarButton>

            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Setting" Label="Settings">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Settings / الإعدادات" />
                    </ToolTipService.ToolTip>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- 3. Multi-Tab Document Layout (TabView) -->
        <TabView x:Name="MainTabView"
                 Grid.Row="2"
                 CanReorderTabs="True"
                 CanDragTabs="True"
                 TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
                 SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                 AddTabButtonCommand="{x:Bind ViewModel.AddNewTabCommand}"
                 TabCloseRequested="MainTabView_TabCloseRequested">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="models:ShellTabModel">
                    <TabViewItem Header="{x:Bind Title, Mode=OneWay}"
                                 IsClosable="{x:Bind IsClosable, Mode=OneWay}">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE8B9;" />
                        </TabViewItem.IconSource>

                        <!-- Right-Click / Touch Long-Press Context Menu -->
                        <TabViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Pin Tab / تثبيت اللسان"
                                                Click="ContextPin_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE718;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Add to Favorites / إضافة للمفضلة"
                                                Click="ContextFavorite_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE734;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Close / إغلاق"
                                                Click="ContextClose_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE711;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Close to the Right / إغلاق جهة اليمين"
                                                Click="ContextCloseRight_Click" />
                                <MenuFlyoutItem Text="Close Others / إغلاق النوافذ الأخرى"
                                                Click="ContextCloseOthers_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Close All / إغلاق الكل"
                                                Click="ContextCloseAll_Click" />
                            </MenuFlyout>
                        </TabViewItem.ContextFlyout>

                        <!-- Tab Body: Drawing Canvas & Drag Hand Zone -->
                        <Grid Background="{ThemeResource AppBackgroundBrush}" Padding="16">
                            <Border BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Background="{ThemeResource AppBackgroundBrush}">
                                <Grid>
                                    <!-- In-canvas Interactive Hand Drag Zone -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                                        <FontIcon Glyph="&#xE768;" FontSize="48" Foreground="{ThemeResource AppAccentBrush}" />
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Drag from here to WhatsApp, Discord, Browser, or Outlook"
                                                   FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- 4. Bottom Status & Auto-Save Indicator -->
        <Border Grid.Row="3" Background="{ThemeResource AppBorderBrush}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedTab.AutoSaveStatus, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="100% | 1920x1080 px" Margin="16,0"
                           FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}" />

                <TextBlock Grid.Column="2" Text="DropCut v1.0 • .NET 10 LTS"
                           FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>

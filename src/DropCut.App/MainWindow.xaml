<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DropCut.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DropCut.Modules.Shell.Models"
    xmlns:viewModels="using:DropCut.Modules.Shell.ViewModels"
    mc:Ignorable="d"
    Title="DropCut">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource AppBackgroundBrush}"
          FlowDirection="{x:Bind GetFlowDirection(ViewModel.IsRtl), Mode=OneWay}"
          KeyDown="Grid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Window TitleBar -->
        <TitleBar x:Name="AppTitleBar" Title="DropCut" />

        <!-- 2. Windows 11 Snipping Tool Style Ribbon Toolbar -->
        <Border Grid.Row="1" Background="{ThemeResource AppBorderBrush}" Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource AppBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Section 1: Capture Mode, Delay & New Snip -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- New Snip SplitButton with Mode Dropdown -->
                    <SplitButton Click="NewSnip_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="جديد" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="مستطيل" Click="ModeRectangle_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="النافذة" Click="ModeWindow_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7C3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="ملء الشاشة" Click="ModeFullscreen_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE740;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="شكل حر" Click="ModeFreeform_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C0;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                        <ToolTipService.ToolTip>
                            <ToolTip Content="قص لقطة جديدة (Ctrl+N أو PrintScreen أو Ctrl+B+B)" />
                        </ToolTipService.ToolTip>
                    </SplitButton>

                    <!-- Snip Countdown Delay DropDownButton -->
                    <DropDownButton Height="36" Padding="6,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE823;" FontSize="13" />
                            <TextBlock x:Name="TxtDelayIndicator" Text="بدون تأخير" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="بدون تأخير (فوري)" Click="DelayNone_Click" />
                                <MenuFlyoutItem Text="قص بعد 3 ثوانٍ" Click="Delay3s_Click" />
                                <MenuFlyoutItem Text="قص بعد 5 ثوانٍ" Click="Delay5s_Click" />
                                <MenuFlyoutItem Text="قص بعد 10 ثوانٍ" Click="Delay10s_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                        <ToolTipService.ToolTip>
                            <ToolTip Content="مؤقت تأخير القص لالتقاط القوائم المنسدلة" />
                        </ToolTipService.ToolTip>
                    </DropDownButton>

                    <!-- Camera Mode Indicator -->
                    <Border Background="{ThemeResource AppAccentBrush}"
                            CornerRadius="4"
                            Padding="8,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE722;" FontSize="13" Foreground="White" />
                            <TextBlock Text="لقطة" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section 2: Drawing, Navigation & Editing Tools -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <!-- Hand Tool: Navigation & Outward Drag Mode -->
                    <Button x:Name="BtnHandTool" Width="36" Height="36" Padding="0" Click="ToolHand_Click">
                        <FontIcon Glyph="&#xE768;" FontSize="15" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="يد التصفح والسحب للمشاركة (Hand Tool)" />
                        </ToolTipService.ToolTip>
                    </Button>

                    <!-- Pen Tool with Color & Size Flyout -->
                    <SplitButton x:Name="BtnPenTool" Height="36" Padding="8,0" Click="ToolPen_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="IconPenGlyph" Glyph="&#xED63;" FontSize="14" Foreground="#FF0000" />
                            <TextBlock Text="القلم" VerticalAlignment="Center" />
                            <Border x:Name="IndicatorPenColor" Width="10" Height="10" CornerRadius="5" Background="#FF0000" BorderBrush="#88000000" BorderThickness="1" VerticalAlignment="Center" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="أحمر (Red)" Click="PenColor_Click" Tag="#FF0000">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FF0000" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="أزرق (Blue)" Click="PenColor_Click" Tag="#0078D7">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#0078D7" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="أسود (Black)" Click="PenColor_Click" Tag="#000000">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#000000" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="أخضر (Green)" Click="PenColor_Click" Tag="#107C41">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#107C41" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="أصفر (Yellow)" Click="PenColor_Click" Tag="#FFD700">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FFD700" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="أبيض (White)" Click="PenColor_Click" Tag="#FFFFFF">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FFFFFF" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="سُمك القلم: دقيق (2px)" Click="PenSize_Click" Tag="2" />
                                <MenuFlyoutItem Text="سُمك القلم: عادي (4px)" Click="PenSize_Click" Tag="4" />
                                <MenuFlyoutItem Text="سُمك القلم: عريض (8px)" Click="PenSize_Click" Tag="8" />
                                <MenuFlyoutItem Text="سُمك القلم: عريض جداً (14px)" Click="PenSize_Click" Tag="14" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                        <ToolTipService.ToolTip>
                            <ToolTip Content="قلم الرسم الحر - انقر للرسم أو افتح القائمة لتحديد اللون والحجم" />
                        </ToolTipService.ToolTip>
                    </SplitButton>

                    <!-- Highlighter Tool with Neon Colors & Size Flyout -->
                    <SplitButton x:Name="BtnHighlighterTool" Height="36" Padding="8,0" Click="ToolHighlighter_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="IconHighlighterGlyph" Glyph="&#xE7E6;" FontSize="14" Foreground="#FFD700" />
                            <TextBlock Text="التمييز" VerticalAlignment="Center" />
                            <Border x:Name="IndicatorHighlighterColor" Width="10" Height="10" CornerRadius="5" Background="#FFFF00" BorderBrush="#88000000" BorderThickness="1" VerticalAlignment="Center" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="أصفر فوسفوري (Fluorescent Yellow)" Click="HighlighterColor_Click" Tag="#FFFF00">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FFFF00" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="أخضر نيون (Neon Green)" Click="HighlighterColor_Click" Tag="#00FF66">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#00FF66" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="سماوي فاتح (Sky Blue)" Click="HighlighterColor_Click" Tag="#00D2FF">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#00D2FF" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="وردي فاقع (Bright Pink)" Click="HighlighterColor_Click" Tag="#FF3399">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FF3399" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="برتقالي مشرق (Bright Orange)" Click="HighlighterColor_Click" Tag="#FF9900">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FF9900" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="بنفسجي فاتح (Lavender)" Click="HighlighterColor_Click" Tag="#CC66FF">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#CC66FF" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="سُمك التمييز: رفيع (12px)" Click="HighlighterSize_Click" Tag="12" />
                                <MenuFlyoutItem Text="سُمك التمييز: متوسط (20px)" Click="HighlighterSize_Click" Tag="20" />
                                <MenuFlyoutItem Text="سُمك التمييز: عريض (32px)" Click="HighlighterSize_Click" Tag="32" />
                                <MenuFlyoutItem Text="سُمك التمييز: عريض جداً (48px)" Click="HighlighterSize_Click" Tag="48" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                        <ToolTipService.ToolTip>
                            <ToolTip Content="قلم التمييز الشفاف (Highlighter) - انقر للتمييز أو افتح القائمة لتحديد اللون والحجم" />
                        </ToolTipService.ToolTip>
                    </SplitButton>

                    <!-- Eraser Tool -->
                    <Button x:Name="BtnEraserTool" Width="36" Height="36" Padding="0" Click="ToolEraser_Click">
                        <FontIcon Glyph="&#xE75C;" FontSize="14" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="ممحاة التعديلات" />
                        </ToolTipService.ToolTip>
                    </Button>

                    <!-- Privacy Redaction & Blur Tool -->
                    <Button x:Name="BtnBlurTool" Width="36" Height="36" Padding="0" Click="ToolBlur_Click">
                        <FontIcon Glyph="&#xE790;" FontSize="14" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="طمس وتمويه البيانات الحساسة (Privacy Blur)" />
                        </ToolTipService.ToolTip>
                    </Button>

                    <!-- Ruler Tool -->
                    <Button x:Name="BtnRulerTool" Width="36" Height="36" Padding="0" Click="ToolRuler_Click">
                        <FontIcon Glyph="&#xED5E;" FontSize="14" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="مسطرة القياس بالبكسل" />
                        </ToolTipService.ToolTip>
                    </Button>

                    <!-- Text Actions / OCR -->
                    <Button x:Name="BtnTextTool" Width="36" Height="36" Padding="0" Click="ToolText_Click">
                        <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="استخراج وقراءة النصوص الذكية (OCR)" />
                        </ToolTipService.ToolTip>
                    </Button>

                    <!-- Crop Tool (Crops current open image) -->
                    <Button x:Name="BtnCropTool" Width="36" Height="36" Padding="0" Click="ToolCrop_Click">
                        <FontIcon Glyph="&#xE7A8;" FontSize="14" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="اقتصاص الصورة الحالية في اللسان" />
                        </ToolTipService.ToolTip>
                    </Button>
                </StackPanel>

                <!-- Section 3: Actions & Sharing (Right Side) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Width="36" Height="36" Padding="0" Click="ActionUndo_Click">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="تراجع (Ctrl+Z)" />
                        </ToolTipService.ToolTip>
                    </Button>

                    <Button Width="36" Height="36" Padding="0" Click="ActionRedo_Click">
                        <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="إعادة (Ctrl+Y)" />
                        </ToolTipService.ToolTip>
                    </Button>

                    <AppBarSeparator />

                    <Button Width="36" Height="36" Padding="0" Click="ActionSave_Click">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="حفظ اللقطة (Ctrl+S)" />
                        </ToolTipService.ToolTip>
                    </Button>

                    <Button Width="36" Height="36" Padding="0" Click="ActionCopy_Click">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="نسخ الصورة للحافظة (Ctrl+C)" />
                        </ToolTipService.ToolTip>
                    </Button>

                    <!-- Drag & Share button: draggable directly into external apps -->
                    <Button Width="36" Height="36" Padding="0"
                            Click="ActionShare_Click"
                            CanDrag="True"
                            DragStarting="ShareButton_DragStarting">
                        <FontIcon Glyph="&#xE72D;" FontSize="14" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="اسحبها وشاركها إلينا (WhatsApp / Telegram / Explorer)" />
                        </ToolTipService.ToolTip>
                    </Button>

                    <Button Width="36" Height="36" Padding="0">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="الإعدادات" Click="MenuSettings_Click" />
                                <MenuFlyoutItem Text="فتح مجلد اللقطات" Click="MenuOpenVault_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="حول البرنامج" Click="MenuAbout_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <ToolTipService.ToolTip>
                            <ToolTip Content="المزيد من الخيارات" />
                        </ToolTipService.ToolTip>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Multi-Tab Document Layout (TabView) with External Drag Support -->
        <Grid Grid.Row="2">
            <TabView x:Name="MainTabView"
                     CanReorderTabs="True"
                     CanDragTabs="True"
                     AllowDrop="True"
                     DragOver="MainTabView_DragOver"
                     Drop="MainTabView_Drop"
                     TabDragStarting="MainTabView_TabDragStarting"
                     AddTabButtonClick="MainTabView_AddTabButtonClick"
                     TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
                     SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                     TabCloseRequested="MainTabView_TabCloseRequested"
                     SelectionChanged="MainTabView_SelectionChanged">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="models:ShellTabModel">
                    <!-- Tab Item with external drag capability -->
                    <TabViewItem Header="{x:Bind Title, Mode=OneWay}"
                                 IsClosable="{x:Bind IsClosable, Mode=OneWay}"
                                 CanDrag="True"
                                 DragStarting="TabItem_DragStarting">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE8B9;" />
                        </TabViewItem.IconSource>

                        <!-- Right-Click / Touch Long-Press Context Menu -->
                        <TabViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Pin Tab / تثبيت اللسان"
                                                Click="ContextPin_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE718;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Add to Favorites / إضافة للمفضلة"
                                                Click="ContextFavorite_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE734;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Close / إغلاق (Ctrl+W)"
                                                Click="ContextClose_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE711;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Close to the Right / إغلاق جهة اليمين"
                                                Click="ContextCloseRight_Click" />
                                <MenuFlyoutItem Text="Close Others / إغلاق النوافذ الأخرى"
                                                Click="ContextCloseOthers_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Close All / إغلاق الكل"
                                                Click="ContextCloseAll_Click" />
                            </MenuFlyout>
                        </TabViewItem.ContextFlyout>

                        <!-- Tab Body: Drawing Canvas & Real Captured Desktop Snapshot Area -->
                        <Grid Background="{ThemeResource AppBackgroundBrush}">
                            <!-- State 1: When real screenshot image is present -->
                            <ScrollViewer Tag="TabScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          ZoomMode="Enabled"
                                          MinZoomFactor="0.1"
                                          MaxZoomFactor="5.0"
                                          Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                    <Border BorderBrush="{ThemeResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{ThemeResource AppBackgroundBrush}">
                                        <!-- Draggable image container with Context Menu (Strict Left-to-Right Cartesian coordinate plane) -->
                                        <Grid CanDrag="{Binding IsHandMode}" DragStarting="ImageContainer_DragStarting" FlowDirection="LeftToRight">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="نسخ الصورة (Copy)" Click="MenuCopy_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8C8;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="حفظ باسم... (Save As)" Click="MenuSave_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74E;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="مشاركة اللقطة" Click="ActionShare_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE72D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="مسح كافة الرسومات" Click="ToolEraser_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE75C;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="الرجوع لوضع اليد 🖐️ (سحب وإفلات)" Click="BtnRevertToHand_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE768;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>

                                            <!-- Captured Screenshot Display -->
                                            <Image Source="{Binding ImageBytes, Converter={StaticResource BytesToBitmapImageConverter}}"
                                                   Stretch="None"
                                                   FlowDirection="LeftToRight"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <!-- Floating Quick Drag & Drop Sharing Pill -->
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="12"
                                                    Background="#E01E1E1E"
                                                    BorderBrush="#44FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="16"
                                                    Padding="12,6"
                                                    CanDrag="True"
                                                    DragStarting="ImageContainer_DragStarting">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE72D;" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" />
                                                    <TextBlock Text="اسحبها وشاركها إلينا (WhatsApp / Telegram / Explorer)"
                                                               FontSize="11"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="اضغط واسحب هذا الزر وأفلته مباشرة داخل أي تطبيق (واتساب، تيليجرام، مستكشف الملفات، إلخ)" />
                                                </ToolTipService.ToolTip>
                                            </Border>

                                            <!-- Interactive Inking & Annotation Canvas Layer (Active only in Drawing Mode) -->
                                            <Canvas Background="Transparent"
                                                    FlowDirection="LeftToRight"
                                                    IsHitTestVisible="{Binding IsDrawingMode}"
                                                    PointerPressed="AnnotationCanvas_PointerPressed"
                                                    PointerMoved="AnnotationCanvas_PointerMoved"
                                                    PointerReleased="AnnotationCanvas_PointerReleased" />

                                            <!-- In-Tab Interactive Crop Overlay Layer -->
                                            <Canvas Background="#40000000"
                                                    FlowDirection="LeftToRight"
                                                    Visibility="{Binding IsCropping, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    PointerPressed="CropCanvas_PointerPressed"
                                                    PointerMoved="CropCanvas_PointerMoved"
                                                    PointerReleased="CropCanvas_PointerReleased">
                                                <!-- Interactive Selection Box -->
                                                <Border BorderBrush="#0078D7"
                                                        BorderThickness="2"
                                                        Background="#100078D7"
                                                        Tag="InTabCropBox"
                                                        Visibility="Collapsed" />

                                                <!-- 8 Interactive Crop Handles & Prominent Dashes (Corners & Edges) -->
                                                <!-- Corner Brackets (Thick 18x18 squares with 3px border and drop shadow) -->
                                                <Border Tag="CropHandle_NW" Width="18" Height="18" Background="White" BorderBrush="#0078D7" BorderThickness="3" CornerRadius="3" Visibility="Collapsed" />
                                                <Border Tag="CropHandle_NE" Width="18" Height="18" Background="White" BorderBrush="#0078D7" BorderThickness="3" CornerRadius="3" Visibility="Collapsed" />
                                                <Border Tag="CropHandle_SE" Width="18" Height="18" Background="White" BorderBrush="#0078D7" BorderThickness="3" CornerRadius="3" Visibility="Collapsed" />
                                                <Border Tag="CropHandle_SW" Width="18" Height="18" Background="White" BorderBrush="#0078D7" BorderThickness="3" CornerRadius="3" Visibility="Collapsed" />

                                                <!-- Edge Dashes (Prominent thick bars: horizontal 42x8 for Top/Bottom, vertical 8x42 for Left/Right) -->
                                                <Border Tag="CropHandle_N"  Width="42" Height="8"  Background="White" BorderBrush="#0078D7" BorderThickness="2" CornerRadius="4" Visibility="Collapsed" />
                                                <Border Tag="CropHandle_S"  Width="42" Height="8"  Background="White" BorderBrush="#0078D7" BorderThickness="2" CornerRadius="4" Visibility="Collapsed" />
                                                <Border Tag="CropHandle_W"  Width="8"  Height="42" Background="White" BorderBrush="#0078D7" BorderThickness="2" CornerRadius="4" Visibility="Collapsed" />
                                                <Border Tag="CropHandle_E"  Width="8"  Height="42" Background="White" BorderBrush="#0078D7" BorderThickness="2" CornerRadius="4" Visibility="Collapsed" />

                                                <!-- Apply / Cancel Crop Actions Floating Pill -->
                                                <StackPanel Tag="InTabCropActionBar"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            Background="#EE1E1E1E"
                                                            BorderBrush="#44FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="6,4"
                                                            Visibility="Collapsed">
                                                    <Button Click="BtnApplyInTabCrop_Click" Style="{ThemeResource AccentButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                                            <TextBlock Text="تطبيق القص" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="BtnCancelInTabCrop_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                            <TextBlock Text="إلغاء" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Canvas>

                                            <!-- In-Tab Privacy Redaction & Blur Overlay Layer -->
                                            <Canvas Background="#30000000"
                                                    FlowDirection="LeftToRight"
                                                    Visibility="{Binding IsBlurring, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    PointerPressed="BlurCanvas_PointerPressed"
                                                    PointerMoved="BlurCanvas_PointerMoved"
                                                    PointerReleased="BlurCanvas_PointerReleased">
                                                <!-- Interactive Selection Box -->
                                                <Border BorderBrush="#F59E0B"
                                                        BorderThickness="2"
                                                        Background="#20F59E0B"
                                                        Tag="InTabBlurBox"
                                                        Visibility="Collapsed" />

                                                <!-- Apply / Cancel Blur Actions Floating Pill -->
                                                <StackPanel Tag="InTabBlurActionBar"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            Background="#EE1E1E1E"
                                                            BorderBrush="#44FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="6,4"
                                                            Visibility="Collapsed">
                                                    <Button Click="BtnApplyInTabBlur_Click" Style="{ThemeResource AccentButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE790;" FontSize="12" />
                                                            <TextBlock Text="تطبيق التمويه" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="BtnCancelInTabBlur_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                            <TextBlock Text="إلغاء" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>

                            <!-- State 2: When no screenshot yet (Subtle, elegant placeholder) -->
                            <Grid Padding="32"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                <Border BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="36,28"
                                        Background="{ThemeResource AppBorderBrush}">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE722;" FontSize="32" Foreground="{ThemeResource AppSecondaryTextBrush}" HorizontalAlignment="Center" />

                                        <TextBlock Text="انقر فوق «جديد» في الأعلى أو اضغط PrintScreen لأخذ لقطة شاشة"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppForegroundBrush}"
                                                   HorizontalAlignment="Center" />

                                        <TextBlock Text="يمكنك أيضاً سحب وإفلات أي صورة إلى هنا لفتحها ومشاركتها"
                                                   FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                   HorizontalAlignment="Center" />

                                        <TextBlock Text="الاختصار العام بالخلفية: Ctrl + B + B أو PrintScreen"
                                                   FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                   Opacity="0.7"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- Mode Status & Revert Guidance Floating Pill -->
        <Border x:Name="ModeGuidancePill"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Background="#EE1E1E1E"
                BorderBrush="#FFD700"
                BorderThickness="2"
                CornerRadius="20"
                Padding="16,8"
                Canvas.ZIndex="99"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon x:Name="IconModeGuidance" Glyph="&#xED63;" FontSize="14" Foreground="#FFD700" />
                <TextBlock x:Name="TxtModeGuidance"
                           Text="وضع التحرير نشط — تم قفل وضع السحب مؤقتاً لحماية الرسم ✏️"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <Button Click="BtnCommitAndSaveEditing_Click"
                        Padding="10,4"
                        Height="28"
                        CornerRadius="14"
                        Background="#107C41"
                        Foreground="White"
                        BorderBrush="#0E6B38"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" />
                        <TextBlock Text="حفظ وإنهاء (✓)" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>
                <Button Click="BtnRevertToHand_Click"
                        Padding="8,4"
                        Height="28"
                        CornerRadius="14">
                    <TextBlock Text="إلغاء (Esc)" FontSize="11" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>

        <!-- 4. Bottom Status & Auto-Save Indicator -->
        <Border Grid.Row="3" Background="{ThemeResource AppBorderBrush}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedTab.AutoSaveStatus, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                </StackPanel>

                <!-- Interactive Zoom Controls (+ / - / Reset) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="16,0" VerticalAlignment="Center">
                    <Button Click="BtnZoomOut_Click" Width="28" Height="28" Padding="0">
                        <FontIcon Glyph="&#xE738;" FontSize="11" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="تصغير (Ctrl + -)" />
                        </ToolTipService.ToolTip>
                    </Button>
                    <Button Click="BtnZoomReset_Click" Height="28" Padding="8,0">
                        <TextBlock Text="{x:Bind ViewModel.SelectedTab.ZoomPercentageText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="الحجم الأصلي 100% (Ctrl + 0)" />
                        </ToolTipService.ToolTip>
                    </Button>
                    <Button Click="BtnZoomIn_Click" Width="28" Height="28" Padding="0">
                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="تكبير (Ctrl + +)" />
                        </ToolTipService.ToolTip>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="DropCut • Windows Snipping Engine (Ctrl+B+B)"
                           FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>

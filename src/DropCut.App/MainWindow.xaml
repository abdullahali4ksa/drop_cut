<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DropCut.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DropCut">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="DropCut" />

        <TabView x:Name="MainTabView" Grid.Row="1">
            <TabView.TabItems>
                <TabViewItem Header="DropCut Studio" IsClosable="False">
                    <Grid Padding="24">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                            <TextBlock Text="DropCut — Windows Desktop Application" 
                                       FontSize="20" FontWeight="SemiBold" 
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Modular Vertical-Slice Architecture | Enterprise Governance" 
                                       FontSize="14" Foreground="{ThemeResource AppSecondaryTextBrush}" 
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</Window>

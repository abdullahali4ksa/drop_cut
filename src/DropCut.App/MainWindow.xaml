<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DropCut.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DropCut.Modules.Shell.Models"
    xmlns:viewModels="using:DropCut.Modules.Shell.ViewModels"
    mc:Ignorable="d"
    Title="DropCut">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootAppGrid"
          Background="{ThemeResource AppBackgroundBrush}"
          FlowDirection="{x:Bind GetFlowDirection(ViewModel.IsRtl), Mode=OneWay}"
          KeyDown="Grid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Window TitleBar -->
        <TitleBar x:Name="AppTitleBar" Title="DropCut" />

        <!-- 2. Windows 11 Snipping Tool Style Ribbon Toolbar -->
        <Border Grid.Row="1" Background="{ThemeResource AppBorderBrush}" Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource AppBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Section 1: Capture Mode, Delay & New Snip -->
                <!-- Section 1: Capture Mode, Delay & New Snip (Pure Clean Icons Law) -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- New Snip SplitButton with Mode Dropdown (Pure Icon +) -->
                    <SplitButton x:Name="BtnNewSnip" Height="36" Padding="10,0" Click="NewSnip_Click">
                        <FontIcon Glyph="&#xE710;" FontSize="15" />
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="MenuModeRect" Text="Rectangle" Click="ModeRectangle_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuModeWin" Text="Window" Click="ModeWindow_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7C3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuModeFull" Text="Fullscreen" Click="ModeFullscreen_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE740;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuModeFree" Text="Freeform" Click="ModeFreeform_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C0;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <!-- Snip Countdown Delay DropDownButton (Pure Icon Clock) -->
                    <DropDownButton x:Name="BtnDelayTool" Height="36" Padding="10,0">
                        <FontIcon Glyph="&#xE823;" FontSize="14" />
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="MenuDelayNone" Text="No delay (Instant)" Click="DelayNone_Click" />
                                <MenuFlyoutItem x:Name="MenuDelay3s" Text="Snip in 3 seconds" Click="Delay3s_Click" />
                                <MenuFlyoutItem x:Name="MenuDelay5s" Text="Snip in 5 seconds" Click="Delay5s_Click" />
                                <MenuFlyoutItem x:Name="MenuDelay10s" Text="Snip in 10 seconds" Click="Delay10s_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Camera Mode Indicator (Pure Camera Icon Badge) -->
                    <Border x:Name="BadgeCameraMode"
                            Background="{ThemeResource AppAccentBrush}"
                            CornerRadius="4"
                            Padding="8,8"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE722;" FontSize="14" Foreground="White" />
                    </Border>
                </StackPanel>

                <!-- Section 2: Drawing, Navigation & Editing Tools (100% Pure Icons with Color Badges) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <!-- Hand Tool: Navigation & Outward Drag Mode -->
                    <Button x:Name="BtnHandTool" Width="36" Height="36" Padding="0" Click="ToolHand_Click">
                        <FontIcon Glyph="&#xE768;" FontSize="15" />
                    </Button>

                    <!-- Pen Tool with Color & Size Flyout (Pure Pen Icon + Color Dot) -->
                    <SplitButton x:Name="BtnPenTool" Height="36" Padding="8,0" Click="ToolPen_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon x:Name="IconPenGlyph" Glyph="&#xED63;" FontSize="14" Foreground="#FF0000" />
                            <Border x:Name="IndicatorPenColor" Width="8" Height="8" CornerRadius="4" Background="#FF0000" BorderBrush="#88000000" BorderThickness="1" VerticalAlignment="Center" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Red" Click="PenColor_Click" Tag="#FF0000">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FF0000" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Blue" Click="PenColor_Click" Tag="#0078D7">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#0078D7" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Black" Click="PenColor_Click" Tag="#000000">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#000000" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Green" Click="PenColor_Click" Tag="#107C41">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#107C41" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Yellow" Click="PenColor_Click" Tag="#FFD700">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FFD700" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="White" Click="PenColor_Click" Tag="#FFFFFF">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FFFFFF" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Fine (2px)" Click="PenSize_Click" Tag="2" />
                                <MenuFlyoutItem Text="Medium (4px)" Click="PenSize_Click" Tag="4" />
                                <MenuFlyoutItem Text="Bold (8px)" Click="PenSize_Click" Tag="8" />
                                <MenuFlyoutItem Text="Extra Bold (14px)" Click="PenSize_Click" Tag="14" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <!-- Highlighter Tool with Neon Colors & Size Flyout (Pure Highlighter Icon + Color Dot) -->
                    <SplitButton x:Name="BtnHighlighterTool" Height="36" Padding="8,0" Click="ToolHighlighter_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon x:Name="IconHighlighterGlyph" Glyph="&#xE7E6;" FontSize="14" Foreground="#FFD700" />
                            <Border x:Name="IndicatorHighlighterColor" Width="8" Height="8" CornerRadius="4" Background="#FFFF00" BorderBrush="#88000000" BorderThickness="1" VerticalAlignment="Center" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Neon Yellow" Click="HighlighterColor_Click" Tag="#FFFF00">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FFFF00" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Neon Green" Click="HighlighterColor_Click" Tag="#00FF66">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#00FF66" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Sky Blue" Click="HighlighterColor_Click" Tag="#00D2FF">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#00D2FF" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Bright Pink" Click="HighlighterColor_Click" Tag="#FF3399">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FF3399" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Bright Orange" Click="HighlighterColor_Click" Tag="#FF9900">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FF9900" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Lavender" Click="HighlighterColor_Click" Tag="#CC66FF">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#CC66FF" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Fine (12px)" Click="HighlighterSize_Click" Tag="12" />
                                <MenuFlyoutItem Text="Medium (20px)" Click="HighlighterSize_Click" Tag="20" />
                                <MenuFlyoutItem Text="Wide (32px)" Click="HighlighterSize_Click" Tag="32" />
                                <MenuFlyoutItem Text="Extra Wide (48px)" Click="HighlighterSize_Click" Tag="48" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <!-- Geometric Shapes & Arrows Tool (Section 2, SplitButton with Dropdown Flyout) -->
                    <SplitButton x:Name="BtnShapeTool" Height="36" Padding="8,0" Click="ToolShape_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon x:Name="IconShapeGlyph" Glyph="&#xE73B;" FontSize="14" Foreground="#FF0000" />
                            <Border x:Name="IndicatorShapeColor" Width="8" Height="8" CornerRadius="4" Background="#FF0000" BorderBrush="#88000000" BorderThickness="1" VerticalAlignment="Center" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="MenuShapeRect" Text="Rectangle" Click="ShapeSelect_Click" Tag="Rectangle">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE73B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuShapeRoundedRect" Text="Rounded Rectangle" Click="ShapeSelect_Click" Tag="RoundedRectangle">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE73B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuShapeEllipse" Text="Circle &amp; Ellipse" Click="ShapeSelect_Click" Tag="Ellipse">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEA3A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuShapeArrow" Text="Directional Arrow" Click="ShapeSelect_Click" Tag="Arrow">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE742;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuShapeLine" Text="Straight Line" Click="ShapeSelect_Click" Tag="Line">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE76E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuShapeCallout" Text="Callout Bubble" Click="ShapeSelect_Click" Tag="Callout">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuShapeColorRed" Text="Red" Click="ShapeColor_Click" Tag="#FF0000">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FF0000" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuShapeColorBlue" Text="Blue" Click="ShapeColor_Click" Tag="#0078D7">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#0078D7" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuShapeColorGreen" Text="Green" Click="ShapeColor_Click" Tag="#107C41">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#107C41" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuShapeColorYellow" Text="Yellow" Click="ShapeColor_Click" Tag="#FFD700">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FFD700" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuShapeColorBlack" Text="Black" Click="ShapeColor_Click" Tag="#000000">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#000000" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuShapeColorWhite" Text="White" Click="ShapeColor_Click" Tag="#FFFFFF">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FFFFFF" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuShapeThickness2" Text="Fine (2px)" Click="ShapeSize_Click" Tag="2" />
                                <MenuFlyoutItem x:Name="MenuShapeThickness4" Text="Medium (4px)" Click="ShapeSize_Click" Tag="4" />
                                <MenuFlyoutItem x:Name="MenuShapeThickness8" Text="Bold (8px)" Click="ShapeSize_Click" Tag="8" />
                                <MenuFlyoutItem x:Name="MenuShapeThickness12" Text="Extra Bold (12px)" Click="ShapeSize_Click" Tag="12" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="MenuShapeFill" Text="Fill Shape" Click="ShapeFill_Click" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <!-- Step Numbering Badges Tool (Section 2, SplitButton ①, ②, ③) -->
                    <SplitButton x:Name="BtnBadgeTool" Height="36" Padding="8,0" Click="ToolBadge_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon x:Name="IconBadgeGlyph" Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource AppAccentBrush}" />
                            <Border x:Name="IndicatorBadgeColor" Width="8" Height="8" CornerRadius="4" Background="#0078D7" BorderBrush="#88000000" BorderThickness="1" VerticalAlignment="Center" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="MenuBadgeColorAccent" Text="Accent Blue" Click="BadgeColor_Click" Tag="#0078D7">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#0078D7" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuBadgeColorRed" Text="Red" Click="BadgeColor_Click" Tag="#E81123">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#E81123" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuBadgeColorOrange" Text="Orange" Click="BadgeColor_Click" Tag="#FF8C00">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#FF8C00" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuBadgeColorGreen" Text="Green" Click="BadgeColor_Click" Tag="#107C41">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#107C41" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="MenuBadgeColorPurple" Text="Purple" Click="BadgeColor_Click" Tag="#881798">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF127;" Foreground="#881798" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuBadgeSizeSmall" Text="Small (24px)" Click="BadgeSize_Click" Tag="24" />
                                <MenuFlyoutItem x:Name="MenuBadgeSizeMedium" Text="Medium (32px)" Click="BadgeSize_Click" Tag="32" />
                                <MenuFlyoutItem x:Name="MenuBadgeSizeLarge" Text="Large (40px)" Click="BadgeSize_Click" Tag="40" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuBadgeReset" Text="Reset counter to 1" Click="BadgeReset_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE777;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <!-- Eraser Tool -->
                    <Button x:Name="BtnEraserTool" Width="36" Height="36" Padding="0" Click="ToolEraser_Click">
                        <FontIcon Glyph="&#xE75C;" FontSize="14" />
                    </Button>

                    <!-- Privacy Redaction & Blur Tool -->
                    <Button x:Name="BtnBlurTool" Width="36" Height="36" Padding="0" Click="ToolBlur_Click">
                        <FontIcon Glyph="&#xE790;" FontSize="14" />
                    </Button>

                    <!-- Ruler Tool -->
                    <Button x:Name="BtnRulerTool" Width="36" Height="36" Padding="0" Click="ToolRuler_Click">
                        <FontIcon Glyph="&#xED5E;" FontSize="14" />
                    </Button>

                    <!-- Text Actions / OCR -->
                    <Button x:Name="BtnTextTool" Width="36" Height="36" Padding="0" Click="ToolText_Click">
                        <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                    </Button>

                    <!-- Crop Tool (Crops current open image) -->
                    <Button x:Name="BtnCropTool" Width="36" Height="36" Padding="0" Click="ToolCrop_Click">
                        <FontIcon Glyph="&#xE7A8;" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- Section 3: Actions & Sharing (Right Side, Pure Icons Law) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="BtnUndo" Width="36" Height="36" Padding="0" Click="ActionUndo_Click">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                    </Button>

                    <Button x:Name="BtnRedo" Width="36" Height="36" Padding="0" Click="ActionRedo_Click">
                        <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                    </Button>

                    <AppBarSeparator />

                    <Button x:Name="BtnSave" Width="36" Height="36" Padding="0" Click="ActionSave_Click">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    </Button>

                    <Button x:Name="BtnCopy" Width="36" Height="36" Padding="0" Click="ActionCopy_Click">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    </Button>

                    <!-- Native Print Button (Windows Print Dialog & PDF) -->
                    <Button x:Name="BtnPrint" Width="36" Height="36" Padding="0" Click="ActionPrint_Click">
                        <FontIcon Glyph="&#xE749;" FontSize="14" />
                    </Button>

                    <!-- Drag & Share button: draggable directly into external apps -->
                    <Button x:Name="BtnShare" Width="36" Height="36" Padding="0"
                            Click="ActionShare_Click"
                            CanDrag="True"
                            DragStarting="ShareButton_DragStarting">
                        <FontIcon Glyph="&#xE72D;" FontSize="14" />
                    </Button>

                    <Button x:Name="BtnMoreOptions" Width="36" Height="36" Padding="0">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="MenuPrint" Text="Print" Click="ActionPrint_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE749;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuSettings" Text="Settings" Click="MenuSettings_Click" />
                                <MenuFlyoutItem x:Name="MenuOpenVault" Text="Vault Gallery" Click="MenuOpenVault_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuAbout" Text="About DropCut" Click="MenuAbout_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Multi-Tab Document Layout (TabView) with External Drag Support -->
        <Grid Grid.Row="2">
            <TabView x:Name="MainTabView"
                     CanReorderTabs="True"
                     CanDragTabs="True"
                     AllowDrop="True"
                     DragOver="MainTabView_DragOver"
                     Drop="MainTabView_Drop"
                     TabDragStarting="MainTabView_TabDragStarting"
                     AddTabButtonClick="MainTabView_AddTabButtonClick"
                     TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
                     SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                     TabCloseRequested="MainTabView_TabCloseRequested"
                     SelectionChanged="MainTabView_SelectionChanged">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="models:ShellTabModel">
                    <!-- Tab Item with external drag capability -->
                    <TabViewItem Header="{x:Bind Title, Mode=OneWay}"
                                 IsClosable="{x:Bind IsClosable, Mode=OneWay}"
                                 CanDrag="True"
                                 DragStarting="TabItem_DragStarting">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE8B9;" />
                        </TabViewItem.IconSource>

                        <!-- Right-Click / Touch Long-Press Context Menu -->
                        <TabViewItem.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Pin Tab"
                                                Click="ContextPin_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE718;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Add to Favorites"
                                                Click="ContextFavorite_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE734;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Close (Ctrl+W)"
                                                Click="ContextClose_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE711;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Close to the Right"
                                                Click="ContextCloseRight_Click" />
                                <MenuFlyoutItem Text="Close Others"
                                                Click="ContextCloseOthers_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Close All"
                                                Click="ContextCloseAll_Click" />
                            </MenuFlyout>
                        </TabViewItem.ContextFlyout>

                        <!-- Tab Body: Drawing Canvas & Real Captured Desktop Snapshot Area -->
                        <Grid Background="{ThemeResource AppBackgroundBrush}">
                            <!-- State 1: When real screenshot image is present -->
                            <ScrollViewer Tag="TabScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          ZoomMode="Enabled"
                                          MinZoomFactor="0.1"
                                          MaxZoomFactor="5.0"
                                          FlowDirection="LeftToRight"
                                          Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                    <Border BorderBrush="{ThemeResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="{ThemeResource AppBackgroundBrush}">
                                        <!-- Draggable image container with Context Menu (Strict Left-to-Right Cartesian coordinate plane) -->
                                        <Grid CanDrag="{Binding IsHandMode}" DragStarting="ImageContainer_DragStarting" FlowDirection="LeftToRight">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Copy Image (Ctrl+C)" Click="MenuCopy_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8C8;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Save As... (Ctrl+S)" Click="MenuSave_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74E;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Share Snippet" Click="ActionShare_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE72D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Clear All Annotations" Click="ToolEraser_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE75C;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Back to Hand Mode 🖐️" Click="BtnRevertToHand_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE768;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>

                                            <!-- Captured Screenshot Display -->
                                            <Image Source="{Binding ImageBytes, Converter={StaticResource BytesToBitmapImageConverter}}"
                                                   Stretch="None"
                                                   FlowDirection="LeftToRight"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <!-- Floating Quick Drag & Drop Sharing Pill -->
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="12"
                                                    Background="#E01E1E1E"
                                                    BorderBrush="#44FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="16"
                                                    Padding="12,6"
                                                    CanDrag="True"
                                                    DragStarting="ImageContainer_DragStarting">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE72D;" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" />
                                                    <TextBlock Text="{x:Bind SharePillText, Mode=OneWay}"
                                                               FontSize="11"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind SharePillToolTip, Mode=OneWay}" />
                                                </ToolTipService.ToolTip>
                                            </Border>

                                            <!-- Interactive Inking & Annotation Canvas Layer (Active only in Drawing Mode) -->
                                            <Canvas Tag="InTabDrawingCanvas"
                                                    Background="Transparent"
                                                    FlowDirection="LeftToRight"
                                                    IsHitTestVisible="{Binding IsDrawingMode}"
                                                    PointerPressed="AnnotationCanvas_PointerPressed"
                                                    PointerMoved="AnnotationCanvas_PointerMoved"
                                                    PointerReleased="AnnotationCanvas_PointerReleased" />

                                            <!-- In-Tab Interactive Crop Overlay Layer -->
                                            <Canvas Background="#40000000"
                                                    FlowDirection="LeftToRight"
                                                    Visibility="{Binding IsCropping, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    PointerPressed="CropCanvas_PointerPressed"
                                                    PointerMoved="CropCanvas_PointerMoved"
                                                    PointerReleased="CropCanvas_PointerReleased">
                                                <!-- Interactive Selection Box -->
                                                <Border BorderBrush="#0078D7"
                                                        BorderThickness="2"
                                                        Background="#100078D7"
                                                        Tag="InTabCropBox"
                                                        Visibility="Collapsed" />

                                                <!-- 8 Interactive Crop Handles & Prominent Dashes (Corners & Edges) -->
                                                <!-- Corner Brackets (Thick 18x18 squares with 3px border and drop shadow) -->
                                                <Border Tag="CropHandle_NW" Width="18" Height="18" Background="White" BorderBrush="#0078D7" BorderThickness="3" CornerRadius="3" Visibility="Collapsed" />
                                                <Border Tag="CropHandle_NE" Width="18" Height="18" Background="White" BorderBrush="#0078D7" BorderThickness="3" CornerRadius="3" Visibility="Collapsed" />
                                                <Border Tag="CropHandle_SE" Width="18" Height="18" Background="White" BorderBrush="#0078D7" BorderThickness="3" CornerRadius="3" Visibility="Collapsed" />
                                                <Border Tag="CropHandle_SW" Width="18" Height="18" Background="White" BorderBrush="#0078D7" BorderThickness="3" CornerRadius="3" Visibility="Collapsed" />

                                                <!-- Edge Dashes (Prominent thick bars: horizontal 42x8 for Top/Bottom, vertical 8x42 for Left/Right) -->
                                                <Border Tag="CropHandle_N"  Width="42" Height="8"  Background="White" BorderBrush="#0078D7" BorderThickness="2" CornerRadius="4" Visibility="Collapsed" />
                                                <Border Tag="CropHandle_S"  Width="42" Height="8"  Background="White" BorderBrush="#0078D7" BorderThickness="2" CornerRadius="4" Visibility="Collapsed" />
                                                <Border Tag="CropHandle_W"  Width="8"  Height="42" Background="White" BorderBrush="#0078D7" BorderThickness="2" CornerRadius="4" Visibility="Collapsed" />
                                                <Border Tag="CropHandle_E"  Width="8"  Height="42" Background="White" BorderBrush="#0078D7" BorderThickness="2" CornerRadius="4" Visibility="Collapsed" />

                                                <!-- Apply / Cancel Crop Actions Floating Pill -->
                                                <StackPanel Tag="InTabCropActionBar"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            Background="#EE1E1E1E"
                                                            BorderBrush="#44FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="6,4"
                                                            Visibility="Collapsed">
                                                    <Button Click="BtnApplyInTabCrop_Click" Style="{ThemeResource AccentButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                                            <TextBlock Text="{x:Bind CropApplyText, Mode=OneWay}" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="BtnCancelInTabCrop_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                            <TextBlock Text="{x:Bind CropCancelText, Mode=OneWay}" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Canvas>

                                            <!-- In-Tab Privacy Redaction & Blur Overlay Layer -->
                                            <Canvas Background="#30000000"
                                                    FlowDirection="LeftToRight"
                                                    Visibility="{Binding IsBlurring, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    PointerPressed="BlurCanvas_PointerPressed"
                                                    PointerMoved="BlurCanvas_PointerMoved"
                                                    PointerReleased="BlurCanvas_PointerReleased">
                                                <!-- Interactive Selection Box -->
                                                <Border BorderBrush="#F59E0B"
                                                        BorderThickness="2"
                                                        Background="#20F59E0B"
                                                        Tag="InTabBlurBox"
                                                        Visibility="Collapsed" />

                                                <!-- Apply / Cancel Blur Actions Floating Pill -->
                                                <StackPanel Tag="InTabBlurActionBar"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            Background="#EE1E1E1E"
                                                            BorderBrush="#44FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="6,4"
                                                            Visibility="Collapsed">
                                                    <Button Click="BtnApplyInTabBlur_Click" Style="{ThemeResource AccentButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE790;" FontSize="12" />
                                                            <TextBlock Text="{x:Bind BlurApplyText, Mode=OneWay}" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="BtnCancelInTabBlur_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                            <TextBlock Text="{x:Bind BlurCancelText, Mode=OneWay}" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>

                            <!-- State 2: When no screenshot yet (Subtle, elegant placeholder) -->
                            <Grid Padding="32"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                <Border BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="36,28"
                                        Background="{ThemeResource AppBorderBrush}">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE722;" FontSize="32" Foreground="{ThemeResource AppSecondaryTextBrush}" HorizontalAlignment="Center" />

                                        <TextBlock Text="{x:Bind LandingSnipHint, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppForegroundBrush}"
                                                   HorizontalAlignment="Center" />

                                        <TextBlock Text="{x:Bind LandingDropHint, Mode=OneWay}"
                                                   FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                   HorizontalAlignment="Center" />

                                        <TextBlock Text="{x:Bind LandingHotkeyHint, Mode=OneWay}"
                                                   FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                   Opacity="0.7"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!-- Mode Status & Revert Guidance Floating Pill -->
        <Border x:Name="ModeGuidancePill"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Background="#EE1E1E1E"
                BorderBrush="#FFD700"
                BorderThickness="2"
                CornerRadius="20"
                Padding="16,8"
                Canvas.ZIndex="99"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon x:Name="IconModeGuidance" Glyph="&#xED63;" FontSize="14" Foreground="#FFD700" />
                <TextBlock x:Name="TxtModeGuidance"
                           Text="Editing Mode Active — Dragging locked temporarily to protect drawing ✏️"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <Button Click="BtnCommitAndSaveEditing_Click"
                        Padding="10,4"
                        Height="28"
                        CornerRadius="14"
                        Background="#107C41"
                        Foreground="White"
                        BorderBrush="#0E6B38"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" />
                        <TextBlock x:Name="TxtCommitSave" Text="Commit &amp; Save (✓)" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>
                <Button Click="BtnRevertToHand_Click"
                        Padding="8,4"
                        Height="28"
                        CornerRadius="14">
                    <TextBlock x:Name="TxtRevertHand" Text="Cancel (Esc)" FontSize="11" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>

        <!-- 4. Bottom Status & Auto-Save Indicator -->
        <Border Grid.Row="3" Background="{ThemeResource AppBorderBrush}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedTab.AutoSaveStatus, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                </StackPanel>

                <!-- Interactive Zoom Controls (+ / - / Reset) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="16,0" VerticalAlignment="Center">
                    <Button x:Name="BtnZoomOut" Click="BtnZoomOut_Click" Width="28" Height="28" Padding="0">
                        <FontIcon Glyph="&#xE738;" FontSize="11" />
                    </Button>
                    <Button x:Name="BtnZoomReset" Click="BtnZoomReset_Click" Height="28" Padding="8,0">
                        <TextBlock Text="{x:Bind ViewModel.SelectedTab.ZoomPercentageText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="BtnZoomIn" Click="BtnZoomIn_Click" Width="28" Height="28" Padding="0">
                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                    </Button>
                </StackPanel>

                <TextBlock x:Name="TxtStatusBarEngine" Grid.Column="2" Text="DropCut • Windows Snipping Engine (Ctrl+B+B)"
                           FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>

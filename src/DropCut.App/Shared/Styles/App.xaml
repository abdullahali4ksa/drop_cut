<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DropCut.App.Shared.Converters">

    <!-- Global Value Converters -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:BoolToFlowDirectionConverter x:Key="BoolToFlowDirectionConverter" />

    <!-- Fallback default palette for custom themes -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#666666" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#666666" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#333333" />
            <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#999999" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
